{"text": "{\"filename\":\"index.html\",\"content\":\"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<title>Task Tracker</title>\\n<link rel=\\\"stylesheet\\\" href=\\\"style.css\\\">\\n<script defer src=\\\"script.js\\\"></script>\\n</head>\\n<body>\\n<div id=\\\"app\\\">\\n  <nav id=\\\"sidebar\\\" aria-label=\\\"Main navigation\\\">\\n    <div class=\\\"sidebar-header\\\">\\n      <span class=\\\"app-icon\\\">✔️</span>\\n      <span class=\\\"app-name\\\">Task Tracker</span>\\n    </div>\\n    <ul class=\\\"nav-list\\\">\\n      <li><a href=\\\"#/dashboard\\\" class=\\\"nav-item\\\" aria-current=\\\"page\\\"><span class=\\\"icon\\\">🏠</span>Dashboard</a></li>\\n      <li><a href=\\\"#/tasks\\\" class=\\\"nav-item\\\"><span class=\\\"icon\\\">🗒️</span>Tasks</a></li>\\n      <li><a href=\\\"#/settings\\\" class=\\\"nav-item\\\"><span class=\\\"icon\\\">⚙️</span>Settings</a></li>\\n    </ul>\\n  </nav>\\n  <div class=\\\"main-wrapper\\\">\\n    <header id=\\\"topbar\\\" aria-label=\\\"Top bar\\\">\\n      <h1 id=\\\"page-title\\\">Dashboard</h1>\\n      <div class=\\\"topbar-controls\\\">\\n        <input type=\\\"search\\\" id=\\\"global-search\\\" placeholder=\\\"Search...\\\" aria-label=\\\"Global search\\\">\\n        <button id=\\\"theme-toggle\\\" aria-label=\\\"Toggle theme\\\">🌓</button>\\n        <button id=\\\"user-avatar\\\" aria-label=\\\"User profile\\\">👤</button>\\n      </div>\\n    </header>\\n    <main id=\\\"content\\\" tabindex=\\\"-1\\\" role=\\\"main\\\" aria-live=\\\"polite\\\">\\n      <!-- Dynamic page content will be injected here -->\\n    </main>\\n  </div>\\n</div>\\n</body>\\n</html>\"}"}