{"text": "{\"filename\":\"index.html\",\"content\":\"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n  <title>SimpleNotes</title>\\n  <link rel=\\\"stylesheet\\\" href=\\\"style.css\\\">\\n</head>\\n<body>\\n  <header class=\\\"app-header\\\">\\n    <h1>SimpleNotes</h1>\\n  </header>\\n  <main id=\\\"app\\\" class=\\\"app-main\\\">\\n    <section id=\\\"note-form-section\\\" class=\\\"section\\\">\\n      <h2>Create a Note</h2>\\n      <form id=\\\"note-form\\\" novalidate>\\n        <div class=\\\"form-group\\\">\\n          <label for=\\\"title\\\">Title</label>\\n          <input type=\\\"text\\\" id=\\\"title\\\" name=\\\"title\\\" required aria-required=\\\"true\\\">\\n        </div>\\n        <div class=\\\"form-group\\\">\\n          <label for=\\\"content\\\">Content</label>\\n          <textarea id=\\\"content\\\" name=\\\"content\\\" rows=\\\"4\\\"></textarea>\\n        </div>\\n        <button type=\\\"submit\\\">Add Note</button>\\n      </form>\\n    </section>\\n    <section id=\\\"note-list-section\\\" class=\\\"section\\\">\\n      <h2>Notes</h2>\\n      <div id=\\\"loading\\\" class=\\\"status hidden\\\" aria-live=\\\"polite\\\">Loading...</div>\\n      <div id=\\\"error\\\" class=\\\"status hidden\\\" aria-live=\\\"assertive\\\"></div>\\n      <div id=\\\"empty-state\\\" class=\\\"empty-state hidden\\\" aria-live=\\\"polite\\\">No notes yet. Create one above.</div>\\n      <ul id=\\\"notes-container\\\" class=\\\"notes-list\\\" aria-live=\\\"polite\\\"></ul>\\n    </section>\\n  </main>\\n  <script defer src=\\\"script.js\\\"></script>\\n</body>\\n</html>\"}", "complete": true}