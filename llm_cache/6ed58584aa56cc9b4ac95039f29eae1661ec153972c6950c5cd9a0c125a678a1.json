{"text": "{\"filename\":\"index.html\",\"content\":\"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<title>CycleTracker</title>\\n<link rel=\\\"stylesheet\\\" href=\\\"style.css\\\">\\n<script defer src=\\\"script.js\\\"></script>\\n</head>\\n<body>\\n<div id=\\\"app\\\">\\n  <aside id=\\\"sidebar\\\" aria-label=\\\"Main navigation\\\">\\n    <div class=\\\"logo\\\">\\n      <span class=\\\"icon-heartbeat\\\" aria-hidden=\\\"true\\\"></span>\\n      <span class=\\\"app-name\\\">CycleTracker</span>\\n    </div>\\n    <nav>\\n      <ul>\\n        <li><a href=\\\"#/home\\\" class=\\\"nav-link\\\" data-icon=\\\"home\\\"><span class=\\\"icon-home\\\" aria-hidden=\\\"true\\\"></span> Home</a></li>\\n        <li><a href=\\\"#/periods\\\" class=\\\"nav-link\\\" data-icon=\\\"period\\\"><span class=\\\"icon-period\\\" aria-hidden=\\\"true\\\"></span> Period Log</a></li>\\n        <li><a href=\\\"#/dashboard\\\" class=\\\"nav-link\\\" data-icon=\\\"dashboard\\\"><span class=\\\"icon-dashboard\\\" aria-hidden=\\\"true\\\"></span> Dashboard</a></li>\\n        <li><a href=\\\"#/settings\\\" class=\\\"nav-link\\\" data-icon=\\\"settings\\\"><span class=\\\"icon-settings\\\" aria-hidden=\\\"true\\\"></span> Settings</a></li>\\n      </ul>\\n    </nav>\\n  </aside>\\n\\n  <div id=\\\"main\\\">\\n    <header id=\\\"topbar\\\" aria-label=\\\"Top bar\\\">\\n      <h1 id=\\\"page-title\\\">Home</h1>\\n      <div class=\\\"topbar-actions\\\">\\n        <input type=\\\"search\\\" id=\\\"global-search\\\" placeholder=\\\"Search...\\\" aria-label=\\\"Search\\\">\\n        <button id=\\\"theme-toggle\\\" aria-label=\\\"Toggle theme\\\"><span class=\\\"icon-theme\\\" aria-hidden=\\\"true\\\"></span></button>\\n        <button id=\\\"user-avatar\\\" aria-label=\\\"User menu\\\"><span class=\\\"icon-user\\\" aria-hidden=\\\"true\\\"></span></button>\\n      </div>\\n    </header>\\n\\n    <main id=\\\"content\\\" role=\\\"main\\\">\\n      <!-- Pages will be injected here by script.js based on hash -->\\n      <section id=\\\"page-home\\\" class=\\\"page\\\">\\n        <h2>Welcome to CycleTracker</h2>\\n        <p>Track your cycles, view insights, and manage reminders.</p>\\n      </section>\\n\\n      <section id=\\\"page-periods\\\" class=\\\"page\\\" hidden>\\n        <h2>Period Log</h2>\\n        <div id=\\\"period-list\\\"></div>\\n        <button id=\\\"add-period-btn\\\">Add Period</button>\\n      </section>\\n\\n      <section id=\\\"page-dashboard\\\" class=\\\"page\\\" hidden>\\n        <h2>Dashboard</h2>\\n        <div id=\\\"kpi-cards\\\" class=\\\"kpi-grid\\\"></div>\\n        <canvas id=\\\"cycle-length-chart\\\" width=\\\"400\\\" height=\\\"200\\\" aria-label=\\\"Cycle Length Chart\\\"></canvas>\\n        <div id=\\\"recent-activity\\\"></div>\\n      </section>\\n\\n      <section id=\\\"page-settings\\\" class=\\\"page\\\" hidden>\\n        <h2>Settings</h2>\\n        <form id=\\\"settings-form\\\">\\n          <label for=\\\"accent-colour\\\">Accent colour</label>\\n          <input type=\\\"color\\\" id=\\\"accent-colour\\\" name=\\\"accent_colour\\\" value=\\\"#336699\\\">\\n          <label for=\\\"theme-mode\\\">Theme mode</label>\\n          <select id=\\\"theme-mode\\\" name=\\\"theme_mode\\\">\\n            <option value=\\\"light\\\">Light</option>\\n            <option value=\\\"dark\\\">Dark</option>\\n          </select>\\n          <button type=\\\"submit\\\">Save</button>\\n        </form>\\n      </section>\\n    </main>\\n  </div>\\n</div>\\n</body>\\n</html>\"}"}