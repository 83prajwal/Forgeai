{"text": "{\n  \"filename\": \"index.html\",\n  \"content\": \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n  <title>CycleTracker</title>\\n  <link rel=\\\"stylesheet\\\" href=\\\"style.css\\\">\\n  <script defer src=\\\"script.js\\\"></script>\\n</head>\\n<body>\\n  <div id=\\\"app\\\">\\n    <!-- Sidebar navigation -->\\n    <aside id=\\\"sidebar\\\" aria-label=\\\"Primary navigation\\\">\\n      <button id=\\\"sidebar-toggle\\\" aria-label=\\\"Toggle navigation\\\" aria-controls=\\\"sidebar\\\" class=\\\"hamburger\\\">\\n        ☰\\n      </button>\\n      <div class=\\\"logo\\\">\\n        <span class=\\\"icon\\\" aria-hidden=\\\"true\\\">&#x2764;&#xFE0F;</span>\\n        <span class=\\\"app-name\\\">CycleTracker</span>\\n      </div>\\n      <nav>\\n        <ul>\\n          <li><a href=\\\"#/home\\\" class=\\\"nav-link\\\" data-icon=\\\"home\\\">Home</a></li>\\n          <li><a href=\\\"#/periods\\\" class=\\\"nav-link\\\" data-icon=\\\"calendar\\\">Period Log</a></li>\\n          <li><a href=\\\"#/dashboard\\\" class=\\\"nav-link\\\" data-icon=\\\"chart\\\">Dashboard</a></li>\\n          <li><a href=\\\"#/settings\\\" class=\\\"nav-link\\\" data-icon=\\\"settings\\\">Settings</a></li>\\n        </ul>\\n      </nav>\\n    </aside>\\n\\n    <!-- Main content area -->\\n    <div id=\\\"main\\\">\\n      <header id=\\\"topbar\\\" aria-label=\\\"Top navigation\\\">\\n        <h1 id=\\\"page-title\\\">Home</h1>\\n        <div class=\\\"top-controls\\\">\\n          <input type=\\\"search\\\" id=\\\"global-search\\\" placeholder=\\\"Search...\\\" aria-label=\\\"Global search\\\">\\n          <button id=\\\"theme-toggle\\\" aria-label=\\\"Toggle theme\\\">🌓</button>\\n          <img src=\\\"avatar.png\\\" alt=\\\"User avatar\\\" id=\\\"user-avatar\\\">\\n        </div>\\n      </header>\\n\\n      <main id=\\\"content\\\" role=\\\"main\\\">\\n        <!-- Home page -->\\n        <section id=\\\"page-home\\\" class=\\\"page\\\" aria-labelledby=\\\"home-heading\\\">\\n          <h2 id=\\\"home-heading\\\">Welcome</h2>\\n          <p>Track your menstrual cycles, flow, symptoms, and reminders.</p>\\n        </section>\\n\\n        <!-- Period Log page -->\\n        <section id=\\\"page-periods\\\" class=\\\"page\\\" hidden aria-labelledby=\\\"periods-heading\\\">\\n          <h2 id=\\\"periods-heading\\\">Period Log</h2>\\n          <div id=\\\"periods-container\\\"></div>\\n        </section>\\n\\n        <!-- Dashboard page -->\\n        <section id=\\\"page-dashboard\\\" class=\\\"page\\\" hidden aria-labelledby=\\\"dashboard-heading\\\">\\n          <h2 id=\\\"dashboard-heading\\\">Dashboard</h2>\\n          <div id=\\\"dashboard-container\\\"></div>\\n        </section>\\n\\n        <!-- Settings page -->\\n        <section id=\\\"page-settings\\\" class=\\\"page\\\" hidden aria-labelledby=\\\"settings-heading\\\">\\n          <h2 id=\\\"settings-heading\\\">Settings</h2>\\n          <div id=\\\"settings-container\\\"></div>\\n        </section>\\n      </main>\\n    </div>\\n  </div>\\n</body>\\n</html>\"\n}"}