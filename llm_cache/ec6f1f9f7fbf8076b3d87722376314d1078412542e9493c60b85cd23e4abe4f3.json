{"text": "{\"filename\":\"index.html\",\"content\":\"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>SimpleTaskTracker</title>\\n<link rel=\\\"stylesheet\\\" href=\\\"style.css\\\">\\n</head>\\n<body>\\n<header>\\n<h1>SimpleTaskTracker</h1>\\n</header>\\n<nav aria-label=\\\"Main navigation\\\">\\n<ul>\\n<li><a href=\\\"#/tasks\\\" id=\\\"nav-tasks\\\">Tasks</a></li>\\n</ul>\\n</nav>\\n<main id=\\\"main-content\\\">\\n<!-- Task List View -->\\n<section id=\\\"task-list-view\\\" class=\\\"view\\\">\\n<h2>Tasks</h2>\\n<div id=\\\"filter-controls\\\">\\n<label for=\\\"status-filter\\\">Filter by status:</label>\\n<select id=\\\"status-filter\\\">\\n<option value=\\\"\\\">All</option>\\n<option value=\\\"pending\\\">Pending</option>\\n<option value=\\\"in_progress\\\">In Progress</option>\\n<option value=\\\"completed\\\">Completed</option>\\n</select>\\n<button id=\\\"add-task-button\\\" type=\\\"button\\\">Add Task</button>\\n</div>\\n<table id=\\\"task-table\\\">\\n<thead>\\n<tr>\\n<th>Title</th>\\n<th>Description</th>\\n<th>Due Date</th>\\n<th>Status</th>\\n<th>Actions</th>\\n</tr>\\n</thead>\\n<tbody>\\n<!-- Rows will be populated by script.js -->\\n</tbody>\\n</table>\\n<div id=\\\"task-list-empty\\\" class=\\\"empty-state\\\" hidden>No tasks found. Create one to get started.</div>\\n</section>\\n<!-- Task Form View -->\\n<section id=\\\"task-form-view\\\" class=\\\"view\\\" hidden>\\n<h2 id=\\\"form-title\\\">Add Task</h2>\\n<form id=\\\"task-form\\\">\\n<div>\\n<label for=\\\"task-title\\\">Title</label>\\n<input type=\\\"text\\\" id=\\\"task-title\\\" name=\\\"title\\\" required>\\n</div>\\n<div>\\n<label for=\\\"task-description\\\">Description</label>\\n<textarea id=\\\"task-description\\\" name=\\\"description\\\" required></textarea>\\n</div>\\n<div>\\n<label for=\\\"task-due-date\\\">Due Date</label>\\n<input type=\\\"date\\\" id=\\\"task-due-date\\\" name=\\\"due_date\\\">\\n</div>\\n<div>\\n<label for=\\\"task-status\\\">Status</label>\\n<select id=\\\"task-status\\\" name=\\\"status\\\" required>\\n<option value=\\\"pending\\\">Pending</option>\\n<option value=\\\"in_progress\\\">In Progress</option>\\n<option value=\\\"completed\\\">Completed</option>\\n</select>\\n</div>\\n<button type=\\\"submit\\\" id=\\\"submit-task-button\\\">Save</button>\\n<button type=\\\"button\\\" id=\\\"cancel-task-button\\\">Cancel</button>\\n</form>\\n</section>\\n</main>\\n<script defer src=\\\"script.js\\\"></script>\\n</body>\\n</html>\"}", "complete": true}